---
import { getCollection } from 'astro:content';
const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
---
<div class="team">
  {team.map((m) => (
    <div class="member">
      <div class="photo">
        {m.data.photo ? (
          <img src={m.data.photo} alt={`${m.data.name}, ${m.data.role}`} loading="lazy" width="300" height="400" />
        ) : (
          <span class="initial" aria-hidden="true">{m.data.name.charAt(0)}</span>
        )}
      </div>
      <h4>{m.data.name}</h4>
      <p>{m.data.role}</p>
    </div>
  ))}
</div>
<style>
  .team { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 32px 24px; text-align: center; }
  .photo { aspect-ratio: 3 / 4; border-radius: 12px; overflow: hidden; background: linear-gradient(160deg, var(--blue-soft), var(--bg)); display: flex; align-items: center; justify-content: center; margin-bottom: 14px; }
  .photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .member:hover .photo img { transform: scale(1.04); }
  .initial { font-size: 3rem; color: var(--blue); font-weight: 500; opacity: 0.6; }
  h4 { margin-bottom: 0.15em; }
  p { margin: 0; color: var(--muted); font-size: 0.95rem; }
</style>
