---
import Icon from './Icon.astro';
import { getCollection, render } from 'astro:content';
const reviews = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(reviews.map(async (r) => ({ ...r, Content: (await render(r)).Content })));
---
<section class="section testimonials" aria-label="Wat klanten zeggen">
  <div class="container">
    <div class="slider" data-slider>
      <span class="bigquote left" aria-hidden="true"><Icon name="quote" size={160} stroke={0.4} /></span>
      <span class="bigquote right" aria-hidden="true"><Icon name="quote" size={160} stroke={0.4} /></span>
      <div class="slides">
        {rendered.map((r, i) => (
          <article class={`slide ${i === 0 ? 'active' : ''}`} aria-hidden={i !== 0}>
            <h3>{r.data.name}{r.data.company && <span class="company"> · {r.data.company}</span>}</h3>
            <div class="text"><r.Content /></div>
          </article>
        ))}
      </div>
      <div class="controls">
        <button type="button" data-prev aria-label="Vorige review"><Icon name="arrow-left" /></button>
        <button type="button" data-next aria-label="Volgende review"><Icon name="arrow-right" /></button>
      </div>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((slider) => {
    const slides = [...slider.querySelectorAll<HTMLElement>('.slide')];
    let i = 0;
    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => { s.classList.toggle('active', k === i); s.setAttribute('aria-hidden', String(k !== i)); });
    };
    slider.querySelector('[data-prev]')?.addEventListener('click', () => show(i - 1));
    slider.querySelector('[data-next]')?.addEventListener('click', () => show(i + 1));
    let timer = window.setInterval(() => show(i + 1), 9000);
    slider.addEventListener('pointerenter', () => window.clearInterval(timer));
    slider.addEventListener('pointerleave', () => { timer = window.setInterval(() => show(i + 1), 9000); });
  });
</script>
<style>
  .slider { position: relative; max-width: 900px; margin: 0 auto; text-align: center; padding: 20px 40px; }
  .bigquote { position: absolute; color: var(--green); opacity: 0.18; top: -20px; }
  .bigquote.left { left: -40px; }
  .bigquote.right { right: -40px; transform: scaleX(-1); }
  .slides { position: relative; min-height: 220px; }
  .slide { display: none; }
  .slide.active { display: block; animation: fade 0.5s ease; }
  .slide h3 { margin-bottom: 0.8em; }
  .company { color: var(--muted); font-weight: 400; font-size: 0.9em; }
  .text { color: var(--muted); font-size: 1.05rem; }
  .controls { display: flex; justify-content: center; gap: 12px; margin-top: 18px; }
  .controls button { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--border); background: #fff; color: var(--blue); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .controls button:hover { background: var(--blue); color: #fff; }
  @keyframes fade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (max-width: 700px) { .bigquote { display: none; } .slider { padding: 0; } }
</style>
