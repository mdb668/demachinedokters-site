---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getEntry } from 'astro:content';
import { metaDescription } from '../lib/slugs';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  transparentHeader?: boolean;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  type?: 'website' | 'article';
}
const site = (await getEntry('settings', 'site'))!.data;
const { title, description, image, transparentHeader = false, noindex = false, jsonLd, type = 'website' } = Astro.props;
const pageTitle = title ?? site.seoTitle;
const pageDesc = metaDescription(description ?? site.seoDescription);
const canonical = new URL(Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`, Astro.site).href;
const ogImage = new URL(image ?? '/images/fotos/team-banner.jpg', Astro.site).href;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${Astro.site}#organization`,
  name: site.siteName,
  legalName: site.legalName,
  url: Astro.site?.href,
  logo: new URL(site.logo, Astro.site).href,
  image: ogImage,
  telephone: site.phone,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.addressLine1,
    postalCode: site.addressLine2.split(' ').slice(0, 2).join(' '),
    addressLocality: site.addressLine2.split(' ').slice(2).join(' '),
    addressCountry: 'NL',
  },
  openingHours: 'Mo-Fr 09:00-17:00',
  sameAs: site.socials.map((s) => s.url),
  areaServed: ['Nederland', 'Noord-Brabant'],
  description: site.seoDescription,
  slogan: site.tagline,
  knowsAbout: [
    'Industriële automatisering', 'Procesoptimalisatie', 'OEE-verbetering', 'Machineonderhoud in de maakindustrie',
    'Storingsanalyse productielijnen', 'PLC- en software-integratie', 'Retrofit van productiemachines',
    'Robotisering', 'Speciaalmachinebouw', 'NEN 3140 en NEN 1010 keuringen', 'Verpakkingslijnen', 'Voedingsmiddelenindustrie',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Diensten',
    itemListElement: [
      'Procesoptimalisatie & industriële automatisering',
      'Onderhoud & storingsanalyse van productiemachines',
      'Software- en PLC-integratie',
      'Training & ondersteuning voor operators en monteurs',
      'NEN 3140 / NEN 1010 keuring',
      'Speciaalmachines & machinebouw',
      'Retrofit van bestaande machines',
      'Robotisering & automatisering',
    ].map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name, serviceType: name, audience: { '@type': 'BusinessAudience', name: 'Productiebedrijven in de maakindustrie' } } })),
  },
};
const ld = [orgLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Blog De Machinedokters" href="/rss.xml" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#074c82" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip" href="#main">Doorgaan naar hoofdinhoud</a>
    <Header transparent={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
<style>
  .skip { position: absolute; left: -9999px; top: 8px; background: var(--blue); color: #fff; padding: 10px 16px; border-radius: 6px; z-index: 1000; }
  .skip:focus { left: 8px; }
</style>
