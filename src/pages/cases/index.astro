---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Behandelplan from '../../components/Behandelplan.astro';
import CtaBand from '../../components/CtaBand.astro';
import { renderText } from '../../lib/md';
import { getEntry, getCollection } from 'astro:content';

const site = (await getEntry('settings', 'site'))!.data;
const p = (await getEntry('pages', 'cases'))!.data;
const cases = (await getCollection('cases', (c) => c.data.published)).sort((a, b) => a.data.order - b.data.order);
---
<Base title={p.seoTitle} description={p.seoDescription}>
  <PageHero title={p.title} subtitle={p.subtitle} intro={p.intro} />
  <section class="section-sm">
    <div class="container list">
      {cases.map((c, i) => (
        <article class={`case ${i % 2 ? 'flip' : ''}`}>
          <a class={`media ${c.data.imageIsLogo ? 'is-logo' : ''}`} href={`/${c.data.slug}`} aria-label={c.data.title}>
            <img src={c.data.image} alt={c.data.imageAlt ?? c.data.title} loading="lazy" width="600" height="400" />
          </a>
          <div class="text">
            <h2><a href={`/${c.data.slug}`}>{c.data.title}</a></h2>
            <p class="sub">{c.data.subtitle}</p>
            <div class="muted" set:html={renderText(c.data.summary)} />
            <a class="more" href={`/${c.data.slug}`}>{p.readMore} →</a>
          </div>
        </article>
      ))}
    </div>
  </section>
  <Behandelplan />
  <CtaBand label={site.ctaLabel} href={site.ctaLink} />
</Base>
<style>
  .list { display: grid; gap: clamp(40px, 6vw, 72px); }
  .case { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 40px; align-items: center; }
  .case.flip .media { order: 2; }
  .media { display: flex; align-items: center; justify-content: center; border-radius: var(--radius); overflow: hidden; background: var(--bg); aspect-ratio: 4 / 3; }
  .media img { width: 100%; height: 100%; object-fit: cover; }
  .media.is-logo { background: #fff; border: 1px solid var(--border); padding: 32px; }
  .media.is-logo img { object-fit: contain; max-height: 180px; }
  .text h2 a { text-decoration: none; }
  .sub { font-weight: 500; color: var(--blue); }
  .more { font-weight: 500; }
  @media (max-width: 800px) { .case { grid-template-columns: 1fr; } .case.flip .media { order: 0; } }
</style>
