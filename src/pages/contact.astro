---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import Mail from '../components/Mail.astro';
import ClientLogos from '../components/ClientLogos.astro';
import { whatsappHref } from '../lib/whatsapp';
import { getEntry } from 'astro:content';

const site = (await getEntry('settings', 'site'))!.data;
const p = (await getEntry('pages', 'contact'))!.data;
const wa = whatsappHref(site);
---
<Base title={p.seoTitle} description={p.seoDescription}>
  <section class="page-hero">
    <div class="container">
      <h1>{p.title}</h1>
      <p class="intro">{p.intro}</p>
    </div>
  </section>
  <section class="section-sm">
    <div class="container contact-grid">
      <div><ContactForm /></div>
      <aside class="info">
        {wa && (
          <a class="wa-card" href={wa} target="_blank" rel="noopener">
            <span class="icon-circle"><Icon name="whatsapp" size={26} /></span>
            <span><strong>Storing of vraag? App ons een foto of filmpje</strong><br /><span class="muted">{site.whatsapp} · normaal reageren we binnen 24 uur</span></span>
          </a>
        )}
        {p.personal && (
          <div class="personal">
            <img src={p.personal.photo} alt={p.personal.photoAlt} width="96" height="96" loading="lazy" />
            <p><strong>{p.personal.title}</strong><br /><span class="muted">{p.personal.text}</span></p>
          </div>
        )}
        <div class="block"><span class="icon-circle"><Icon name="pin" size={26} /></span><div><h4>{p.labels.address}</h4><p>{site.addressLine1}<br />{site.addressLine2}</p></div></div>
        <div class="block"><span class="icon-circle"><Icon name="phone" size={26} /></span><div><h4>{p.labels.phone}</h4><p><a href={site.phoneLink}>{site.phone}</a></p></div></div>
        <div class="block"><span class="icon-circle"><Icon name="mail" size={26} /></span><div><h4>{p.labels.email}</h4><p><Mail /></p></div></div>
        <div class="block"><span class="icon-circle"><Icon name="clock" size={26} /></span><div><h4>{p.labels.hours}</h4><p>{site.openingHours}</p></div></div>
        {p.mapEmbed && (
          <div class="map-wrap" data-map-src={p.mapEmbed}>
            <p class="muted small">De kaart wordt geladen via Google Maps. Google kan daarbij cookies plaatsen; daarom laden we de kaart pas als jij dat wilt.</p>
            <div class="btn-group" style="justify-content:flex-start">
              <button type="button" class="btn btn-outline btn-sm" data-map-load>Kaart tonen</button>
              <a class="btn btn-outline btn-sm" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.addressLine1 + ', ' + site.addressLine2)}`} target="_blank" rel="noopener">Openen in Google Maps</a>
            </div>
          </div>
        )}
      </aside>
    </div>
  </section>
  {p.review && (
    <section class="section-sm">
      <div class="container-narrow center">
        <blockquote class="review">“{p.review.text}”<cite>{p.review.name}</cite></blockquote>
      </div>
    </section>
  )}
  <ClientLogos />
</Base>
<script>
  document.querySelectorAll<HTMLElement>('[data-map-src]').forEach((wrap) => {
    wrap.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.className = 'map'; f.src = wrap.dataset.mapSrc!; f.title = 'Kaart met onze locatie'; f.loading = 'lazy'; f.referrerPolicy = 'no-referrer-when-downgrade';
      wrap.replaceChildren(f);
    });
  });
</script>
<style>
  .contact-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: start; }
  .info { display: grid; gap: 22px; }
  .block { display: flex; gap: 16px; align-items: flex-start; }
  .block h4 { margin-bottom: 0.2em; }
  .block p { margin: 0; color: var(--muted); }
  .small { font-size: 0.9rem; }
  .wa-card { display: flex; gap: 16px; align-items: center; padding: 16px 18px; border: 2px solid #25d366; border-radius: var(--radius); background: #f2fcf5; color: var(--text, inherit); text-decoration: none !important; }
  .wa-card .icon-circle { color: #1da851; border-color: #25d366; flex: none; }
  .wa-card:hover { background: #e6f9ec; }
  .personal { display: flex; gap: 16px; align-items: center; }
  .personal img { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; flex: none; }
  .personal p { margin: 0; }
  .review { font-size: 1.15rem; color: var(--blue); margin: 0; }
  .review cite { display: block; margin-top: 10px; font-style: normal; font-size: 0.95rem; color: var(--muted); }
  .map { width: 100%; height: 280px; border: 0; border-radius: var(--radius); margin-top: 8px; }
  @media (max-width: 860px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
