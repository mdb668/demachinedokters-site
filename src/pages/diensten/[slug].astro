---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Inzet from '../../components/Inzet.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqList from '../../components/FaqList.astro';
import Icon from '../../components/Icon.astro';
import { getEntry, getCollection, render } from 'astro:content';
import { serviceSlug } from '../../lib/slugs';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((s) => ({ params: { slug: serviceSlug(s) }, props: { service: s } }));
}
const { service } = Astro.props;
const site = (await getEntry('settings', 'site'))!.data;
const d = service.data;
const { Content } = await render(service);
const slug = serviceSlug(service);
const others = (await getCollection('services')).filter((s) => s.id !== service.id).sort((a, b) => a.data.order - b.data.order);
const allCases = (await getCollection('cases', (c) => c.data.published)).sort((a, b) => a.data.order - b.data.order);
const related = d.relatedCases?.length ? allCases.filter((c) => d.relatedCases!.includes(c.data.slug)) : allCases.slice(0, 3);
const title = d.seoTitle ?? `${d.title} | ${site.siteName}`;
const description = d.seoDescription ?? d.short;
const url = new URL(`/diensten/${slug}`, Astro.site).href;
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: d.title,
    serviceType: d.title,
    description,
    url,
    provider: { '@id': `${Astro.site}#organization` },
    areaServed: ['Nederland', 'Noord-Brabant'],
    audience: { '@type': 'BusinessAudience', name: 'Productiebedrijven in de maakindustrie' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Diensten', item: new URL('/diensten', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---
<Base title={title} description={description} image={d.image} jsonLd={ld}>
  <PageHero title={d.title} subtitle={d.tagline} intro={d.short}>
    <nav class="crumbs" aria-label="Kruimelpad"><a href="/">Home</a> › <a href="/diensten">Diensten</a> › <span>{d.title}</span></nav>
  </PageHero>

  <section class="section-sm">
    <div class="container detail">
      <div class="prose text"><Content /></div>
      {d.image && <img src={d.image} alt={d.imageAlt ?? d.title} width="700" height="480" class="rounded shadow" loading="eager" />}
    </div>
  </section>

  {related.length > 0 && (
    <section class="section-sm section-bg">
      <div class="container">
        <h2 class="center"><span class="title-underline">Resultaten uit de praktijk</span></h2>
        <div class="grid grid-3 cases">
          {related.map((c) => (
            <a class="card case" href={`/${c.data.slug}`}>
              <div class={`media ${c.data.imageIsLogo ? 'is-logo' : ''}`}><img src={c.data.image} alt={c.data.imageAlt ?? c.data.title} loading="lazy" width="400" height="260" /></div>
              <h3>{c.data.title}</h3>
              <p class="muted">{c.data.subtitle}</p>
              <span class="more">Lees de case <Icon name="arrow-right" size={18} /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section-sm">
    <div class="container-narrow">
      <h2>Veelgestelde vragen</h2>
      <FaqList limit={6} />
      <p class="center more-faq"><a href="/veelgestelde-vragen">Alle veelgestelde vragen →</a></p>
    </div>
  </section>

  <section class="section-sm section-bg">
    <div class="container">
      <h2 class="center"><span class="title-underline">Onze andere diensten</span></h2>
      <div class="grid grid-3 others">
        {others.map((s) => (
          <a class="card other" href={`/diensten/${serviceSlug(s)}`}>
            <span class="icon-circle"><Icon name={s.data.icon} size={28} stroke={1.4} /></span>
            <h3>{s.data.title}</h3>
            <p class="muted">{s.data.tagline}</p>
          </a>
        ))}
        <a class="card other" href="/service-onderhoud">
          <span class="icon-circle"><Icon name="alert" size={28} stroke={1.4} /></span>
          <h3>Service & onderhoud</h3>
          <p class="muted">Storingsdienst, revisies en preventief onderhoud.</p>
        </a>
      </div>
    </div>
  </section>

  <Inzet button1Label="Meer Business Cases" button1Link="/cases" button2Label="Contact" button2Link="/contact" />
  <CtaBand label={site.ctaLabel} href={site.ctaLink} />
</Base>
<style>
  .crumbs { font-size: 0.9rem; color: var(--muted); margin-top: 8px; }
  .detail { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 48px; align-items: start; }
  .detail img { width: 100%; height: auto; position: sticky; top: 110px; }
  .text :global(p:first-child) { font-size: 1.1rem; }
  .cases .case, .others .other { text-decoration: none !important; color: inherit; display: block; }
  .cases .media { aspect-ratio: 3 / 2; border-radius: 10px; overflow: hidden; background: var(--bg); margin-bottom: 14px; display: flex; align-items: center; justify-content: center; }
  .cases .media img { width: 100%; height: 100%; object-fit: cover; }
  .cases .media.is-logo { background: #fff; border: 1px solid var(--border); padding: 20px; }
  .cases .media.is-logo img { object-fit: contain; }
  .cases h3, .others h3 { font-size: 1.15rem; margin-bottom: 0.3em; }
  .others h3 { margin-top: 14px; }
  .more { display: inline-flex; align-items: center; gap: 6px; color: var(--blue); font-weight: 500; }
  .more-faq { margin-top: 20px; }
  @media (max-width: 860px) { .detail { grid-template-columns: 1fr; } .detail img { position: static; } }
</style>
