---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { getEntry } from 'astro:content';
import { whatsappHref } from '../lib/whatsapp';

const site = (await getEntry('settings', 'site'))!.data;
const wa = whatsappHref(site);

/* ---------- Vragen, antwoorden en recepten ---------- */
type Answer = { label: string; to: string };
/** scene = wat de getekende machine doet bij deze vraag */
type Question = { id: string; question: string; hint: string; scene: string; answers: [Answer, Answer] };

const questions: Question[] = [
  { id: 'q1', scene: 'twijfelt', question: 'Beweegt het?',
    hint: 'De machine, de lijn of dat ene onderdeel waar iedereen met een boog omheen loopt.',
    answers: [{ label: 'Ja', to: 'q2a' }, { label: 'Nee', to: 'q2b' }] },
  { id: 'q2a', scene: 'draait', question: 'Hoort het te bewegen?',
    hint: 'Het beweegt dus. De vraag is of dat de bedoeling was.',
    answers: [{ label: 'Ja', to: 'q3a' }, { label: 'Nee, dat is nieuw', to: 'tape' }] },
  { id: 'q2b', scene: 'stil', question: 'Hoort het te bewegen?',
    hint: 'Het staat stil. Soms is dat precies goed.',
    answers: [{ label: 'Ja, eigenlijk wel', to: 'q3b' }, { label: 'Nee', to: 'rust' }] },
  { id: 'q3a', scene: 'draait', question: 'Doet het ook wat je wilt?',
    hint: 'Hij draait. Maar haalt hij ook wat je nodig hebt?',
    answers: [{ label: 'Ja, prima', to: 'rust' }, { label: 'Nee: te traag, te veel uitval of steeds storing', to: 'q4' }] },
  { id: 'q3b', scene: 'stil', question: 'Heb je er al WD-40 op gespoten?',
    hint: 'Eerlijk antwoorden. Wij zien het toch.',
    answers: [{ label: 'Ja, de bus is leeg', to: 'q4' }, { label: 'Nee, nog niet', to: 'wd' }] },
  { id: 'q4', scene: 'hapert', question: 'Zit er al duct tape op?',
    hint: 'Geen oordeel. We zijn gewoon benieuwd.',
    answers: [{ label: 'Ja, meerdere lagen', to: 'q5' }, { label: 'Nee, nog niet', to: 'q5' }] },
  { id: 'q5', scene: 'hapert', question: 'Is de machine zelf nog de moeite waard?',
    hint: 'Los van dit probleem: doet hij nog wat jouw productie nodig heeft?',
    answers: [{ label: 'Ja, de basis is goed', to: 'dokter' }, { label: 'Nee, hij is op of we zijn eruit gegroeid', to: 'nieuw' }] },
];

const blogHref = '/post/de-duct-tape-methode-waarom-tijdelijke-oplossingen-je-proces-langzaam-slopen';

const waLink = wa ? [{ label: 'Stuur een foto via WhatsApp', href: wa, primary: true, external: true }] : [];
const recepten = [
  { id: 'tape', scene: 'trilt', title: 'Duct tape', dose: '1 rol. Niet verlengen.', wanneer: 'Het beweegt en dat hoort niet.',
    text: 'Het beweegt en dat hoort niet. Tape is dan de reflex en je haalt er het einde van de dienst mee. Alleen blijft zo’n pleister in de praktijk maanden zitten, soms jaren, en de oorzaak zie je niet meer. Zit het bij een sensor of beveiliging: niet plakken, machine uit.',
    links: [...waLink, { label: 'Lees over de Duct-tape Methode', href: blogHref, primary: !wa }, { label: 'Neem contact op', href: '/contact' }] },
  { id: 'wd', scene: 'draait', title: 'WD-40', dose: '2 keer spuiten. Helpt het niet, dan bellen.', wanneer: 'Het hoort te bewegen en doet het niet.',
    text: 'Het hoort te bewegen en doet het niet. Machine uit, spuiten, even wachten, nog een keer proberen. Helpt het? Mooi. Komt het terug? Dan los je het met spuiten niet op.',
    links: [...waLink, { label: 'Bekijk service & onderhoud', href: '/service-onderhoud', primary: !wa }, { label: 'Neem contact op', href: '/contact' }] },
  { id: 'rust', scene: 'draait', title: 'Afblijven en vastleggen', dose: '1 foto van elke instelling.', wanneer: 'Het doet gewoon wat het moet doen.',
    text: 'Het doet wat het moet doen. Niks aan veranderen dus. Leg wel vast hoe het nu staat: noteer de instellingen en maak foto’s van de afstelling. Zo weet je later hoe het hoorde.',
    links: [{ label: 'Bekijk service & onderhoud', href: '/service-onderhoud', primary: true }] },
  { id: 'dokter', scene: 'rustig', title: 'Een Machinedokter op locatie', dose: '1 Machinedokter. Eerst een foto.', wanneer: 'Tape en WD-40 helpen niet meer, de machine zelf is nog goed.',
    text: 'Met een spuitbus of een rol tape kom je hier niet verder. De machine zelf is nog goed. Stuur een foto of filmpje en we kijken vrijblijvend mee. We reageren normaal binnen 24 uur. Zo nodig komen we één dag langs om hem te repareren. Wanneer dat kan, hangt af van waar je zit en van onze planning.',
    links: [...waLink, { label: 'Zo werkt de reparatiedag', href: '/diensten/retrofit' }, { label: 'Neem contact op', href: '/contact' }] },
  { id: 'nieuw', scene: 'schets', title: 'Een nieuwe machine', dose: '1 blanco vel.', wanneer: 'De machine is op, of je bent eruit gegroeid.',
    text: 'Hier helpt geen tape meer. Je hebt een machine nodig die past bij wat je nu maakt. Die ontwerpen en bouwen we vanaf een blanco vel. Twijfel je of het zover is? Soms is een retrofit genoeg.',
    links: [{ label: 'Bekijk machinebouw', href: '/diensten/speciaalmachines', primary: true }, { label: 'Of toch een retrofit', href: '/diensten/retrofit' }, { label: 'Bespreek je idee', href: '/contact' }] },
];

/* Tandwiel als veelhoek (8 tanden) rond 0,0 */
function gear(teeth: number, rOut: number, rIn: number) {
  const pts: string[] = [];
  const step = (Math.PI * 2) / teeth;
  for (let i = 0; i < teeth; i++) {
    const a = i * step;
    for (const [off, r] of [[-0.3, rIn], [-0.17, rOut], [0.17, rOut], [0.3, rIn]] as const) {
      pts.push(`${(Math.cos(a + off * step * 1.6) * r).toFixed(1)},${(Math.sin(a + off * step * 1.6) * r).toFixed(1)}`);
    }
  }
  return pts.join(' ');
}
const gearPts = gear(8, 30, 22);

/* Het hele schema als plaatje: [x, y, breedte] en korte tekst per blokje */
const NH = 54;
const schema: Record<string, { p: [number, number, number]; t: string[] }> = {
  q1: { p: [320, 40, 150], t: ['Beweegt het?'] },
  q2a: { p: [150, 160, 150], t: ['Hoort het', 'te bewegen?'] },
  q2b: { p: [465, 160, 150], t: ['Hoort het', 'te bewegen?'] },
  tape: { p: [70, 290, 126], t: ['Duct tape'] },
  q3a: { p: [215, 290, 140], t: ['Doet het', 'wat je wilt?'] },
  rust: { p: [390, 290, 132], t: ['Vastleggen'] },
  q3b: { p: [545, 290, 150], t: ['Al WD-40', 'geprobeerd?'] },
  q4: { p: [320, 420, 150], t: ['Zit er al', 'duct tape op?'] },
  wd: { p: [545, 420, 116], t: ['WD-40'] },
  q5: { p: [320, 540, 170], t: ['Machine nog', 'de moeite waard?'] },
  dokter: { p: [185, 660, 190], t: ['Machinedokter', 'op locatie'] },
  nieuw: { p: [455, 660, 190], t: ['Nieuwe machine', 'bouwen'] },
};
const lijnen = (() => {
  const map = new Map<string, { from: string; to: string; ja: boolean; nee: boolean }>();
  for (const q of questions) for (const a of q.answers) {
    const key = `${q.id}-${a.to}`;
    const e = map.get(key) ?? { from: q.id, to: a.to, ja: false, nee: false };
    if (a.label.toLowerCase().startsWith('ja')) e.ja = true; else e.nee = true;
    map.set(key, e);
  }
  const R = 14;
  return [...map.entries()].map(([key, e]) => {
    const [ax, ay, aw] = schema[e.from].p, [bx, by, bw] = schema[e.to].p;
    let d: string, lx: number, ly: number;
    if (ay === by) {
      d = `M${ax + aw / 2} ${ay}H${bx - bw / 2}`; lx = (ax + aw / 2 + bx - bw / 2) / 2; ly = ay;
    } else {
      const y1 = ay + NH / 2, y2 = by - NH / 2, my = (y1 + y2) / 2;
      if (ax === bx) { d = `M${ax} ${y1}V${y2}`; lx = ax; ly = my; }
      else {
        const s = bx > ax ? 1 : -1;
        d = `M${ax} ${y1}V${my - R}Q${ax} ${my} ${ax + s * R} ${my}H${bx - s * R}Q${bx} ${my} ${bx} ${my + R}V${y2}`;
        lx = (ax + bx) / 2; ly = my;
      }
    }
    const soort = e.ja && e.nee ? 'beide' : e.ja ? 'ja' : 'nee';
    const label = soort === 'beide' ? 'Ja of nee' : soort === 'ja' ? 'Ja' : 'Nee';
    return { key, d, lx, ly, soort, label, w: label.length * 7.4 + 18 };
  });
})();

const clientData = {
  questions: Object.fromEntries(questions.map((q) => [q.id, { question: q.question, hint: q.hint, scene: q.scene, answers: q.answers }])),
  scenes: Object.fromEntries(recepten.map((r) => [r.id, r.scene])),
};
---
<Base
  title="Machinecheck: tape, WD-40 of dokter? | De Machinedokters"
  description="Doe de machinecheck. In een halve minuut weet je wat je machine nodig heeft: duct tape, WD-40, een Machinedokter op locatie of een nieuwe machine."
>
  <!-- Losse plaatjes per recept, hergebruikt in het recept en in het overzicht -->
  <svg width="0" height="0" class="visually-hidden" aria-hidden="true">
    <defs>
      <symbol id="p-tape" viewBox="0 0 96 96">
        <path class="f-tape" d="M38 70H86V54l-5.5 3-5.5-3-5.5 3-5.5-3-4 2z" />
        <circle class="f-sky" cx="38" cy="42" r="28" /><circle class="f-licht" cx="38" cy="42" r="17" /><circle class="f-wit" cx="38" cy="42" r="8" />
        <path class="lijn wit" d="M20 30a22 22 0 0 1 9-9" />
        <path class="lijn steun" d="M72 22l6-8M80 32l9-4M64 14l1-9" />
      </symbol>
      <symbol id="p-wd" viewBox="0 0 96 96">
        <rect class="f-sky" x="26" y="38" width="36" height="50" rx="6" /><rect class="f-wit" x="26" y="52" width="36" height="22" />
        <path class="vol-navy" d="M44 56c4 5 6 8 6 10a6 6 0 0 1-12 0c0-2 2-5 6-10z" />
        <path class="f-licht" d="M30 38c0-6 5-9 14-9s14 3 14 9z" /><rect class="f-navy" x="37" y="15" width="14" height="14" rx="3" />
        <path class="lijn steun dik" d="M51 21h28" />
        <path class="lijn sky" d="M85 12l6-5M87 21h7M85 30l6 5" />
      </symbol>
      <symbol id="p-rust" viewBox="0 0 96 96">
        <rect class="f-wit" x="12" y="16" width="52" height="70" rx="7" /><rect class="f-sky" x="26" y="8" width="24" height="15" rx="4" />
        <path class="lijn groen dik" d="M23 41l7 7 13-14" /><path class="lijn" d="M23 60h18M23 72h12" />
        <path class="f-sky" d="M58 56l3-7h14l3 7z" /><rect class="f-sky" x="48" y="56" width="40" height="30" rx="6" />
        <circle class="f-wit" cx="68" cy="71" r="8" /><circle class="vol-steun" cx="81" cy="63" r="2.6" />
      </symbol>
      <symbol id="p-dokter" viewBox="0 0 96 96">
        <path class="slangk" d="M64 36c0-16 22-16 22 2v20" />
        <path class="lijn" d="M28 36v-9a6 6 0 0 1 6-6h14a6 6 0 0 1 6 6v9" />
        <rect class="f-sky" x="6" y="36" width="70" height="46" rx="9" /><rect class="f-wit" x="27" y="45" width="28" height="28" rx="7" />
        <path class="lijn groen dik" d="M41 51v16M33 59h16" />
        <circle class="f-wit" cx="86" cy="64" r="7" /><circle class="vol-steun" cx="86" cy="64" r="2.4" />
      </symbol>
      <symbol id="p-nieuw" viewBox="0 0 96 96">
        <path class="f-wit" d="M10 12h42l18 18v54H10z" /><path class="f-licht" d="M52 12v18h18z" />
        <rect class="f-sky" x="20" y="44" width="32" height="22" rx="4" /><circle class="f-wit" cx="36" cy="55" r="6" />
        <path class="lijn" d="M20 76h32M20 73v6M52 73v6" />
        <g transform="rotate(32 78 62)"><rect class="f-licht" x="72" y="30" width="12" height="9" rx="2" /><rect class="f-steun" x="72" y="39" width="12" height="32" /><path class="f-wit" d="M72 71h12l-6 13z" /></g>
        <path class="vol-groen" d="M84 8l2.4 6.6 6.6 2.4-6.6 2.4L84 26l-2.4-6.6L75 17l6.6-2.4z" />
      </symbol>
    </defs>
  </svg>

  <section class="page-hero kop">
    <div class="container kop-in">
      <div>
        <h1>Duct tape, WD-40 of een Machinedokter?</h1>
        <p class="sub">De machinecheck: een diagnose in een halve minuut.</p>
        <p class="intro">Beantwoord een paar vragen en je krijgt een recept. Bedoeld als knipoog: tape en WD-40 zijn noodgrepen, geen reparatie. Het advies eronder menen we wel.</p>
      </div>
      <img class="kop-beeld" src="/images/illustraties/klembord-check-up.png" alt="" width="300" height="300" />
    </div>
  </section>

  <section class="check">
    <div class="container">
      <div class="kaart" data-mc hidden>
        <header class="kaart-kop">
          <span>Patiëntkaart</span>
          <span data-stap>Vraag 1</span>
        </header>
        <div class="kaart-in">
          <div class="panel" aria-live="polite">
            <div class="vraag" data-vraag>
              <h2 data-q></h2>
              <p class="hint" data-hint></p>
              <div class="antwoorden">
                <button class="antwoord" type="button" data-a="0"></button>
                <button class="antwoord" type="button" data-a="1"></button>
              </div>
              <button class="link" type="button" data-terug hidden>Vorige vraag</button>
            </div>

            {recepten.map((r) => (
              <article class="recept" data-recept={r.id} hidden>
                <h2><span class="rp-teken" aria-hidden="true">Rp.</span> {r.title}</h2>
                <p class="uitleg">{r.text}</p>
                <p class="dosering">Dosering: {r.dose}</p>
                <div class="acties">
                  {r.links.map((l) => (
                    <a class={`btn btn-sm ${l.primary ? 'btn-dark' : 'btn-outline'}`} href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>{l.label}</a>
                  ))}
                </div>
                <button class="link" type="button" data-opnieuw>Opnieuw beginnen</button>
              </article>
            ))}
          </div>

          <!-- De patiënt: beweegt mee met je antwoorden -->
          <div class="toneel">
            <span class="stempel" aria-hidden="true">Diagnose gesteld</span>
            <svg class="machine" data-machine data-scene="twijfelt" viewBox="0 0 420 340" role="img" aria-label="Getekende machine die meebeweegt met je antwoorden">
              <path class="lijn grond" d="M20 312h44M84 312h252M356 312h44" />
              <g class="m">
                <!-- transportband met dozen -->
                <rect class="f-wit" x="96" y="262" width="16" height="48" /><rect class="f-wit" x="308" y="262" width="16" height="48" />
                <g class="dozen">
                  <rect class="f-licht doos" x="44" y="194" width="36" height="34" rx="4" />
                  <rect class="f-licht doos d2" x="44" y="194" width="36" height="34" rx="4" />
                  <rect class="f-licht doos d3" x="44" y="194" width="36" height="34" rx="4" />
                </g>
                <rect class="f-wit" x="30" y="228" width="360" height="36" rx="18" />
                <g class="rollen"><circle cx="56" cy="246" r="8" /><circle cx="108" cy="246" r="8" /><circle cx="312" cy="246" r="8" /><circle cx="364" cy="246" r="8" /></g>
                <!-- kast -->
                <path class="lijn" d="M210 74v-14" /><circle class="lamp" cx="210" cy="48" r="12" />
                <rect class="f-wit" x="160" y="74" width="100" height="30" rx="9" />
                <rect class="f-sky kast" x="124" y="100" width="172" height="150" rx="16" />
                <circle class="f-wit" cx="180" cy="170" r="44" />
                <g transform="translate(180 170)"><g class="tandwiel"><polygon class="f-navy" points={gearPts} /><circle class="f-wit" r="9" /></g></g>
                <rect class="f-navy" x="238" y="128" width="46" height="38" rx="7" />
                <path class="hartslag" pathLength="100" d="M243 148h8l4-10 6 20 5-14 3 4h10" />
                <circle class="f-wit knop" cx="250" cy="190" r="7" /><circle class="f-wit knop" cx="272" cy="190" r="7" />
                <path class="lijn" d="M240 214h42" />
                <!-- pleisters -->
                <g class="extra x-tape">
                  <rect class="f-tape" x="104" y="150" width="212" height="30" rx="3" transform="rotate(-14 210 165)" />
                  <rect class="f-tape" x="150" y="196" width="150" height="26" rx="3" transform="rotate(11 225 209)" />
                </g>
                <g class="extra x-dokter">
                  <path class="slang" d="M330 60c-6 40 10 62 30 84 20 22 10 62-22 62h-30" />
                  <circle class="f-wit" cx="296" cy="206" r="17" /><circle class="f-groen" cx="296" cy="206" r="7" />
                  <path class="slang" d="M316 44l14 16 16-14" />
                </g>
              </g>
              <g class="extra x-zzz"><path class="lijn" d="M306 70h16l-16 18h16M336 40h12l-12 14h12" /></g>
              <g class="extra x-vraag"><path class="lijn steun dik" d="M316 62c0-18 28-18 28-2 0 12-14 12-14 26" /><circle class="vol-steun" cx="330" cy="102" r="5" /></g>
              <g class="extra x-wd">
                <rect class="f-sky" x="24" y="84" width="40" height="70" rx="6" /><rect class="f-wit" x="24" y="104" width="40" height="24" />
                <rect class="f-navy" x="36" y="62" width="16" height="16" rx="3" /><path class="f-licht" d="M30 84v-7h28v7z" />
                <path class="lijn" d="M52 69l44 22" />
                <g class="spray"><circle cx="110" cy="100" r="4" /><circle cx="124" cy="116" r="5" /><circle cx="118" cy="88" r="3" /><circle cx="138" cy="104" r="4" /></g>
              </g>
              <g class="extra x-rust"><circle class="f-groen" cx="334" cy="92" r="34" /><path class="vink" d="M318 92l11 12 22-24" /></g>
              <g class="extra x-nieuw">
                <path class="f-groen ster" d="M344 60l5 15 15 5-15 5-5 15-5-15-15-5 15-5z" />
                <path class="f-steun ster s2" d="M82 92l4 10 10 4-10 4-4 10-4-10-10-4 10-4z" />
                <path class="f-groen ster s3" d="M372 168l3 8 8 3-8 3-3 8-3-8-8-3 8-3z" />
              </g>
            </svg>
          </div>
        </div>
      </div>

      <svg class="hartlijn" viewBox="0 0 1120 70" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
        <path class="basis" d="M0 40h488M632 40h488" /><path class="puls" d="M488 40h26l14-22 14 44 16-56 16 52 12-24 10 6h22" />
      </svg>

      <h2 class="center">Alle recepten op een rij</h2>
      <ul class="tegels">
        {recepten.map((r) => (
          <li class="tegel">
            <div class="tegel-beeld"><svg class="plaatje" viewBox="0 0 96 96" aria-hidden="true"><use href={`#p-${r.id}`} /></svg></div>
            <div class="tegel-tekst">
              <h3>{r.title}</h3>
              <p>{r.wanneer}</p>
            </div>
          </li>
        ))}
      </ul>

      <div class="schema-blok" data-schema>
        <h2>Het hele schema in één keer</h2>
        <p class="muted">Liever alleen kijken? Volg de lijnen van boven naar beneden. Jouw route kleurt groen mee.</p>
        <div class="schema-scroll">
          <svg class="schema" viewBox="0 0 640 716" role="img" aria-labelledby="mc-titel mc-desc">
            <title id="mc-titel">Stroomschema van de machinecheck</title>
            <desc id="mc-desc">Beweegt het en hoort dat niet: duct tape. Beweegt het niet en hoort dat wel: WD-40. Helpt dat niet en is de machine nog goed: een Machinedokter op locatie. Is de machine op: een nieuwe machine bouwen. Doet alles wat het moet doen: afblijven en vastleggen.</desc>
            {lijnen.map((e) => <path class="tak" data-edge={e.key} d={e.d} />)}
            {lijnen.map((e) => (
              <g class={`pil ${e.soort}`} data-edge={e.key}>
                <rect x={e.lx - e.w / 2} y={e.ly - 12} width={e.w} height="24" rx="12" />
                <text x={e.lx} y={e.ly + 4.5} text-anchor="middle">{e.label}</text>
              </g>
            ))}
            {Object.entries(schema).map(([id, n]) => {
              const [x, y, w] = n.p;
              const uit = !id.startsWith('q');
              const tx = uit ? x + 17 : x;
              return (
                <g class={`blok ${uit ? 'uitkomst' : ''}`} data-node={id}>
                  <rect x={x - w / 2} y={y - NH / 2} width={w} height={NH} rx={uit ? NH / 2 : 12} />
                  {uit && <use href={`#p-${id}`} x={x - w / 2 + 12} y={y - 17} width="34" height="34" />}
                  <text x={tx} y={y - (n.t.length - 1) * 9 + 5} text-anchor="middle">
                    {n.t.map((l, i) => <tspan x={tx} dy={i === 0 ? 0 : 18}>{l}</tspan>)}
                  </text>
                </g>
              );
            })}
          </svg>
        </div>
      </div>

      <p class="spreuk"><span>Beweegt het en hoort dat niet: tape.<br />Beweegt het niet en hoort dat wel: WD-40.<br />Blijft het terugkomen: bellen.</span></p>
      <p class="kleine-letters muted">Kleine lettertjes: deze check is een knipoog. Plak geen tape over sensoren of beveiligingen. Bij twijfel: bel of app ons. WD-40 is een merk van WD-40 Company.</p>
    </div>
  </section>

  <CtaBand label={site.ctaLabel} href={site.ctaLink} title="Toch liever een echte diagnose?" text="Bel of app ons. Een foto of filmpje is genoeg om mee te kijken." />

  <script type="application/json" id="mc-data" set:html={JSON.stringify(clientData)} />
</Base>

<script>
  type A = { label: string; to: string };
  type Q = { question: string; hint: string; scene: string; answers: [A, A] };
  const root = document.querySelector<HTMLElement>('[data-mc]');
  const raw = document.getElementById('mc-data')?.textContent;
  if (root && raw) {
    const data: { questions: Record<string, Q>; scenes: Record<string, string> } = JSON.parse(raw);
    const qs = data.questions;
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const vraag = $<HTMLElement>('[data-vraag]');
    const stap = $<HTMLElement>('[data-stap]');
    const qEl = $<HTMLElement>('[data-q]');
    const hint = $<HTMLElement>('[data-hint]');
    const knoppen = [...root.querySelectorAll<HTMLButtonElement>('[data-a]')];
    const terug = $<HTMLButtonElement>('[data-terug]');
    const recepten = [...root.querySelectorAll<HTMLElement>('[data-recept]')];
    const machine = $<SVGElement>('[data-machine]');

    const schema = document.querySelector<HTMLElement>('[data-schema]');

    let pad: string[] = ['q1'];
    root.hidden = false;
    root.querySelectorAll<HTMLElement>('[data-opnieuw]').forEach((b) => b.addEventListener('click', () => { pad = ['q1']; teken(true); }));

    function teken(focus = false) {
      const nu = pad[pad.length - 1];
      const q = qs[nu];
      vraag.hidden = !q;
      recepten.forEach((r) => (r.hidden = r.dataset.recept !== nu));
      root!.classList.toggle('is-recept', !q);
      machine.dataset.scene = q ? q.scene : data.scenes[nu];
      machine.dataset.recept = q ? '' : nu;
      if (q) {
        stap.textContent = `Vraag ${pad.length}`;
        qEl.textContent = q.question;
        hint.textContent = q.hint;
        knoppen.forEach((k, i) => (k.textContent = q.answers[i].label));
        terug.hidden = pad.length < 2;
        vraag.classList.remove('wissel'); void vraag.offsetWidth; vraag.classList.add('wissel');
      } else {
        stap.textContent = 'Recept';
      }
      const routes = new Set(pad.slice(1).map((id, i) => `${pad[i]}-${id}`));
      schema?.querySelectorAll<SVGElement>('[data-node]').forEach((n) => {
        n.classList.toggle('aan', pad.includes(n.dataset.node!));
        n.classList.toggle('nu', n.dataset.node === nu);
      });
      schema?.querySelectorAll<SVGElement>('[data-edge]').forEach((e) => e.classList.toggle('aan', routes.has(e.dataset.edge!)));
      if (focus) {
        const doel = q ? knoppen[0] : recepten.find((r) => !r.hidden)?.querySelector<HTMLElement>('a, button');
        doel?.focus({ preventScroll: true });
        if (root!.getBoundingClientRect().top < 90) root!.scrollIntoView({ block: 'start' });
      }
    }

    knoppen.forEach((k, i) => k.addEventListener('click', () => {
      pad.push(qs[pad[pad.length - 1]].answers[i].to);
      teken(true);
    }));
    terug.addEventListener('click', () => { pad.pop(); teken(true); });
    teken();
  }
</script>

